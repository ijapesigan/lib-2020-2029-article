@Article{Goldberg-Hanley-Baldwin-etal-2020,
  author = {Simon B. Goldberg and Adam W. Hanley and Scott A. Baldwin and Amit Bernstein and Eric L. Garland},
  date = {2020-09},
  journaltitle = {Psychotherapy},
  title = {Does mindfulness practice promote psychological functioning or is it the other way around? A daily diary study},
  doi = {10.1037/pst0000286},
  number = {3},
  pages = {310--322},
  volume = {57},
  abstract = {Although mindfulness-based interventions are widely used, the relationship between practice dosage and psychological functioning remains unclear. Twenty-five participants completed daily assessments throughout a 12-week Mindfulness-Oriented Recovery Enhancement intervention. Analyses separated whether meditation occurred from the amount of time practiced and examined positive affect, negative affect, and state mindfulness. Practice and psychological outcomes were related within the same day, but practice did not prospectively predict next-day outcomes. Instead, greater negative affect predicted less next-day practice, whereas greater mindfulness predicted more next-day practice. Additional analyses indicated that practice altered the continuity of daily affect. The findings suggest that psychological functioning may influence subsequent meditation behavior and that the association may be reciprocal rather than simply reflecting benefits produced by greater practice time.},
}
