@Article{Berli-Inauen-Stadler-etal-2021,
  author       = {Berli, Corina and Inauen, Jennifer and Stadler, Gertraud and Scholz, Urte and Shrout, Patrick E},
  date         = {2021},
  journaltitle = {Annals of Behavioral Medicine},
  title        = {Understanding Between-Person Interventions With Time-Intensive Longitudinal Outcome Data: Longitudinal Mediation Analyses},
  doi          = {10.1093/abm/kaaa066},
  issn         = {1532-4796},
  number       = {5},
  pages        = {476--488},
  volume       = {55},
  publisher    = {Oxford University Press (OUP)},
  abstract     = {Mediation analysis is commonly used to investigate how interventions influence health outcomes, but conventional approaches often give limited attention to how mediation processes unfold over time. This article presents a framework for studying the effects of a between-person intervention on repeatedly measured mediators and outcomes. The framework consists of five conceptual and analytic steps that examine intervention effects on the outcome, intervention effects on the mediator, associations between mediator and outcome, the resulting mediated process over time, and selection of an appropriate statistical model. Two health behavior intervention examples illustrate how longitudinal multilevel structural equation models can represent changes in the magnitudes of direct and indirect effects across time. The authors emphasize that the temporal dynamics of mediation should be treated as an important component of causal analyses of interventions.},
}
