@Article{Shao-Ong-2026,
  author = {Sijing Shao and Anthony D. Ong},
  date = {2026-08},
  journaltitle = {Emotion},
  title = {Seven challenges in affective inertia research},
  doi = {10.1037/emo0001630},
  number = {5},
  pages = {1118--1132},
  volume = {26},
  abstract = {Affective inertia describes the persistence of emotional states over time and has important implications for well-being and emotion regulation. Progress in this area has nevertheless been constrained by conceptual ambiguity, measurement problems, and statistical limitations. The authors identify seven related challenges involving distinctions between inertia and emotional stability, the treatment of ordinal observations with continuous-data models, and assumptions such as stationarity. They review developments in research design, measurement, model estimation, and diagnostic testing that may help address these problems. Greater conceptual and methodological precision should improve the interpretation of affective inertia and strengthen its use in basic and clinically oriented emotion research.},
}
