@Article{Brose-Neubauer-Schmiedek-2022,
  author = {Annette Brose and Andreas Benjamin Neubauer and Florian Schmiedek},
  date = {2022},
  journaltitle = {European Journal of Personality},
  title = {Integrating state dynamics and trait change: A tutorial using the example of stress reactivity and change in well-being},
  doi = {10.1177/08902070211014055},
  issn = {1099-0984},
  number = {2},
  pages = {180--199},
  volume = {36},
  publisher = {SAGE Publications},
  abstract = {Theories of trait change increasingly emphasize the possibility that repeated state experiences and state dynamics contribute to longer-term changes in individual differences. Research linking processes such as daily stress reactivity to changes in well-being has often relied on a two-step approach in which state dynamics and trait change are modeled separately. This tutorial presents one-step procedures for estimating state dynamics and longer-term change simultaneously within a multilevel structural equation modeling framework. Using stress reactivity and change in well-being as an example, the authors describe the advantages of jointly modeling within-person dynamics and between-person differences in change and provide practical guidance for substantive researchers interested in connecting short-term processes with longer-term development.},
}
