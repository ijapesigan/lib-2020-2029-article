@Article{Fredrickson-Arizmendi-VanCappellen-2021,
  author = {Barbara L. Fredrickson and Cara Arizmendi and Patty {Van Cappellen}},
  title = {Same-day, cross-day, and upward spiral relations between positive affect and positive health behaviours},
  journaltitle = {Psychology \& Health},
  date = {2021-04},
  volume = {36},
  number = {4},
  pages = {444--460},
  doi = {10.1080/08870446.2020.1778696},
  issn = {1476-8321},
  publisher = {Informa UK Limited},
  abstract = {This study examined same-day and cross-day relations between positive affect and positive health behaviours, including physical activity, fruit and vegetable consumption, and meditation. The analyses used intensive daily data from midlife adults participating in a randomized meditation study. The authors examined whether positive affect and health behaviours were associated within the same day, whether either predicted the other on the following day, and whether repeated associations were consistent with an upward spiral process. Results indicated substantial same-day associations between positive affect and several health behaviours, whereas cross-day associations were more selective. The findings highlight the importance of distinguishing contemporaneous from prospective relations when evaluating reciprocal links between positive affect and health behaviour.},
}
