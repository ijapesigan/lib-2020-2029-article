@Article{VanCappellen-Catalino-Fredrickson-2020,
  author = {Patty {Van Cappellen} and Lahnna I. Catalino and Barbara L. Fredrickson},
  date = {2020-12},
  journaltitle = {Emotion},
  title = {A new micro-intervention to increase the enjoyment and continued practice of meditation},
  doi = {10.1037/emo0000684},
  number = {8},
  pages = {1332--1343},
  volume = {20},
  abstract = {Maintaining a newly adopted health behavior can be difficult, including the continued practice of meditation. Drawing on the upward spiral theory of lifestyle change, this experiment examined whether positive emotions experienced during an initial meditation session encouraged later practice. Midlife adults were assigned in a two-by-two design to receive either instruction about adaptive ways of prioritizing positivity or control information and then to complete either loving-kindness or mindfulness meditation. Participants subsequently reported their meditation behavior for 21 days. The positivity intervention enhanced enjoyment particularly during loving-kindness meditation, and greater positive emotion during the initial session predicted more frequent and longer subsequent practice. The findings highlight enjoyment as a potentially modifiable contributor to sustained meditation.},
}
