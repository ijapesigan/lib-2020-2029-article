@Article{Don-VanCappellen-Fredrickson-2022,
  author       = {Don, Brian P. and Van Cappellen, Patty and Fredrickson, Barbara L.},
  date         = {2022-04},
  journaltitle = {Mindfulness},
  title        = {Training in mindfulness or loving-kindness meditation is associated with lower variability in social connectedness across time},
  doi          = {10.1007/s12671-022-01856-0},
  issn         = {1868-8535},
  number       = {5},
  pages        = {1173--1184},
  volume       = {13},
  publisher    = {Springer Science and Business Media LLC},
  abstract     = {Meditation research has generally focused on average levels of social outcomes, although fluctuations in social functioning may also be important for well-being. Using data from a randomized study of 224 mid-life adults, this study examined changes in the variability of daily social connectedness during mindfulness or loving-kindness meditation training. Participants reported social connectedness and emotions daily for two weeks before training, six weeks during training, and three weeks afterward. Participants in both meditation conditions showed reduced variability in social connectedness during the intervention even after accounting for average connectedness. Reductions in variability of both positive and negative emotions partially accounted for the decline in social connectedness variability. The findings suggest that meditation training may be associated not only with levels of social connectedness but also with greater stability in social experience over time.},
}
