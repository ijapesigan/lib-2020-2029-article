@Article{Boker-Daniel-Orzek-2023,
  author = {Steven M. Boker and Katharine E. Daniel and Jannik Orzek},
  date = {2023-08},
  journaltitle = {Multivariate Behavioral Research},
  title = {Separating long-term equilibrium adaptation from short-term self-regulation dynamics using latent differential equations},
  doi = {10.1080/00273171.2023.2228302},
  issn = {1532-7906},
  number = {6},
  pages = {1177--1187},
  volume = {59},
  publisher = {Informa UK Limited},
  abstract = {Self-regulatory systems may change simultaneously at different timescales, with short-term fluctuations occurring around an equilibrium that itself changes gradually over longer periods. The authors propose a model that combines a second-order linear differential equation for short-timescale regulation with a first-order linear differential equation for long-timescale adaptation of the equilibrium. The model also permits individual differences to moderate parameters governing short-term dynamics. A simulation study indicates that the model can recover reasonable parameter estimates even when the short and long timescales substantially overlap. An empirical application to emotional well-being among recently bereaved widows illustrates how the approach can distinguish short-term regulation from longer-term adaptation.},
}
