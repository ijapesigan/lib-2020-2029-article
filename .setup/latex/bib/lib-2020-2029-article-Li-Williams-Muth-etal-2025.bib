@Article{Li-Williams-Muth-etal-2025,
  author       = {Li, Yanling and Williams, Lindy and Muth, Chelsea and Heshmati, Saeideh and Chow, Sy-Miin and Oravecz, Zita},
  date         = {2025},
  journaltitle = {Structural Equation Modeling: A Multidisciplinary Journal},
  title        = {A growth of hierarchical autoregression model for capturing individual differences in changes of dynamic characteristics of psychological processes},
  doi          = {10.1080/10705511.2024.2402328},
  issn         = {1532-8007},
  number       = {2},
  pages        = {237--250},
  volume       = {32},
  publisher    = {Informa UK Limited},
  abstract     = {Intensive longitudinal studies sometimes include multiple measurement phases or bursts, making it possible to investigate psychological change at several timescales. Existing combinations of growth curve and autoregressive models do not always make full use of known phase structure when modeling such data. The authors propose a Bayesian growth of hierarchical autoregression model that integrates autoregressive processes with growth curves to describe changes in multiple dynamic characteristics, including baseline levels, variability, and regulation, while also estimating individual differences in these changes. The model is applied to ecological momentary assessment data collected across a mobile health intervention. Results for meaning in life suggested decreasing fluctuations and increasing regulation over time, although the intervention itself did not provide a credible additional benefit. The approach provides a unified framework for examining developmental changes in psychological dynamics across individuals and study phases.},
}
