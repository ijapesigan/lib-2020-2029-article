@Article{Levi-Shoham-Amir-etal-2021,
  author = {Karin Levi and Adi Shoham and Iftach Amir and Amit Bernstein},
  date = {2021-07/2021-08},
  journaltitle = {Psychosomatic Medicine},
  title = {The daily dose-response hypothesis of mindfulness meditation practice: An experience sampling study},
  doi = {10.1097/PSY.0000000000000912},
  number = {6},
  pages = {624--630},
  volume = {83},
  abstract = {This study examined whether the amount of daily mindfulness meditation practice predicts temporally proximal outcomes during an intervention. Eighty-two meditation-naive adults completed intensive assessments of home practice, state mindfulness, decentering, emotional valence, and arousal during a 21-day mindfulness-based intervention. Total accumulated practice did not predict the assessed outcomes at postintervention. At the daily level, however, more practice was associated with greater same-day mindfulness, decentering, and positive emotional valence, but not arousal. These associations did not persist into the following day. The results support a daily dose-response process in which the benefits associated with home practice are reliable but short-lived rather than cumulative.},
}
