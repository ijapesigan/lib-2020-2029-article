@Article{Kury-Fredrickson-VanCappellen-etal-2026,
  author = {Manuella B. Kury and Barbara L. Fredrickson and Patty {Van Cappellen} and Brian P. Don},
  date = {2026-05},
  journaltitle = {Mindfulness},
  title = {Understanding the affective and mental health outcomes of meditation interventions: The role of individual differences in self-compassion},
  doi = {10.1007/s12671-026-02803-z},
  pages = {1497--1513},
  volume = {17},
  abstract = {Meditation interventions can benefit emotional, social, and mental health, but their effects vary across individuals. This preregistered study tested whether baseline self-compassion moderated responses to mindfulness meditation and loving-kindness meditation. Data came from 217 adults who completed six weeks of meditation training and reported emotions, social connectedness, and depressive symptoms. Participants with lower initial self-compassion generally experienced larger reductions in guilt, shame, and depression and greater increases in social connectedness across the intervention. Increases in self-compassion mediated reductions in depression among participants who began with lower self-compassion. Baseline self-compassion did not consistently moderate associations between meditation on a specific day and that day's outcomes. The results suggest that people lower in self-compassion may derive especially strong longer-term benefits from meditation training.},
}
