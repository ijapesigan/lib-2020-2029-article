@Article{Xie-Riordan-Baldwin-etal-2024,
  author       = {Xie, Qiang and Riordan, Kevin M. and Baldwin, Scott A. and Simonsson, Otto and Hirshberg, Matthew J. and Dahl, Cortland J. and Nahum-Shani, Inbal and Davidson, Richard J. and Goldberg, Simon B.},
  date         = {2024-06},
  journaltitle = {Behaviour Research and Therapy},
  title        = {Is informal practice associated with outcomes in loving-kindness and compassion training? Evidence from pre-post and daily diary assessments},
  doi          = {10.1016/j.brat.2024.104537},
  issn         = {0005-7967},
  pages        = {104537},
  volume       = {177},
  publisher    = {Elsevier BV},
  abstract     = {This study examined whether informal meditation practice, defined as applying meditative techniques outside periods of formal meditation, was associated with outcomes during smartphone-based loving-kindness and compassion training. Meditation-naive participants with clinically elevated symptoms completed a two-week intervention, with 351 participants providing measures of psychological distress, loneliness, empathy, and prosociality before and after training. Informal practice, distress, and loneliness were also assessed daily. Greater increases in informal practice were associated with larger pre-post reductions in psychological distress and loneliness but not with changes in empathy or prosociality. Longitudinal models separating within-person fluctuations from longer-term trajectories showed that greater informal practice on a given day predicted lower psychological distress on the following day, whereas a comparable prospective association was not found for loneliness. The findings suggest that informal practice may contribute to some outcomes of app-based loving-kindness and compassion training, particularly psychological distress.},
}
