@Article{Ong-Dejonckheere-Ram-2025,
  author = {Anthony D. Ong and Egon Dejonckheere and Nilam Ram},
  date = {2025-10},
  journaltitle = {Current Directions in Psychological Science},
  title = {Positive affect dynamics},
  doi = {10.1177/09637214251339454},
  number = {5},
  pages = {301--308},
  volume = {34},
  abstract = {Positive affect is central to well-being and contributes to psychological and physical functioning. This review synthesizes research on how positive affect unfolds within people in everyday settings and across multiple timescales. It considers variability, instability, inertia, and reactivity and examines their associations with adaptive functioning and health. Dynamic approaches may improve prediction beyond conventional trait- and state-based summaries, but their use is complicated by difficulties in measurement, modeling, and integration across temporal resolutions and contexts. The authors outline methodological priorities for improving the precision and interpretation of positive affect dynamics and discuss applications for promoting health and resilience.},
}
